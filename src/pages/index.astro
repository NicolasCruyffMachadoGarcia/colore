---
import '../global.css';
import Galeria from '../components/Galeria.jsx';
// 1. Importamos nuestra conexión a Supabase
import { supabase } from '../lib/supabase.js';

// 2. Traemos todos los datos de la tabla 'paquetes'
// ¡Adiós a escribir SELECT * FROM paquetes de forma manual!
const { data: paquetes, error } = await supabase.from('paquetes').select('*');

// Si hay un error en consola te avisará, si no, ya tienes los datos listos para usar
if (error) console.error("Error trayendo paquetes:", error);
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Colore - Shows Infantiles</title>
  </head>
  <body class="bg-slate-50 text-slate-900 font-sans">
    
    <!-- Barra de Navegación -->
    <nav class="bg-white shadow-sm p-4 flex justify-between items-center">
      <h1 class="text-3xl font-extrabold text-purple-600 tracking-tight">Colore 🎉</h1>
      <ul class="flex gap-6 font-semibold text-slate-600">
        <li><a href="#" class="hover:text-purple-600 transition-colors">Servicios</a></li>
        <li><a href="#catalogo" class="hover:text-purple-600 transition-colors">Catálogo</a></li>
        <li><a href="#" class="hover:text-purple-600 transition-colors">Contacto</a></li>
      </ul>
    </nav>

    <!-- Sección Principal (Hero) -->
    <main class="text-center py-24 px-4 flex flex-col items-center justify-center min-h-[80vh]">
      <h2 class="text-6xl font-black text-transparent bg-clip-text bg-gradient-to-r from-purple-500 to-pink-500 mb-6">
        La magia de los shows infantiles
      </h2>
      <p class="text-xl text-slate-600 mb-10 max-w-2xl">
        Hacemos de cada cumpleaños y evento una experiencia inolvidable. Animadores, juegos, luces y pura diversión.
      </p>
      
      <a href="#catalogo" class="bg-purple-600 text-white px-8 py-4 rounded-full font-bold text-lg hover:bg-purple-700 transition-all transform hover:scale-105 shadow-lg hover:shadow-purple-500/50">
        Ver Catálogo de Precios
      </a>
    </main>

    <!-- Galería (React) -->
    <section class="bg-white py-20 border-t border-slate-200">
      <Galeria client:visible />
    </section>

    <!-- NUEVA SECCIÓN: Catálogo de Precios desde Supabase -->
    <section id="catalogo" class="py-20 bg-slate-100">
      <div class="max-w-6xl mx-auto px-4">
        <h3 class="text-4xl font-black text-center mb-12 text-slate-800">Nuestros Paquetes</h3>
        
        <!-- Grid para que las tarjetas se acomoden solas -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          
          {/* 3. Recorremos los datos usando un simple .map() de JavaScript */}
          {paquetes && paquetes.map((paquete) => (
            <div class="bg-white rounded-3xl p-6 shadow-xl hover:shadow-2xl transition-shadow border border-slate-100 flex flex-col">
              
              {/* Si subiste una imagen, la muestra. Si no, muestra un color plano de relleno */}
              {paquete.imagen_url ? (
                <img src={paquete.imagen_url} alt={paquete.nombre} class="w-full h-48 object-cover rounded-2xl mb-4" />
              ) : (
                <div class="w-full h-48 bg-purple-100 rounded-2xl mb-4 flex items-center justify-center">
                  <span class="text-4xl">🎈</span>
                </div>
              )}
              
              <h4 class="text-2xl font-bold text-slate-800 mb-2">{paquete.nombre}</h4>
              <p class="text-slate-600 mb-6 flex-grow">{paquete.descripcion}</p>
              
              <div class="mt-auto border-t border-slate-100 pt-4 flex justify-between items-center">
                <span class="text-3xl font-black text-purple-600">{paquete.precio}</span>
                <button class="bg-slate-900 text-white px-4 py-2 rounded-xl font-semibold hover:bg-purple-600 transition-colors">
                  Reservar
                </button>
              </div>
            </div>
          ))}

        </div>
      </div>
    </section>

  </body>
</html>